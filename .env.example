# Environment Variables - GoldGen Auto Poster
# Salin ke .env (atau isi di panel environment Dokploy), lalu sesuaikan.

# === APPLICATION ===
PORT=18794
HOST=0.0.0.0
TZ=Asia/Jakarta

# === SECURITY (WAJIB DIGANTI DI PRODUKSI) ===
# PIN untuk login dashboard. Default 888888 — ganti!
DASHBOARD_PIN=
# Kunci penandatangan session cookie. Kosongkan untuk auto-generate
# dan disimpan di data/secret.key (jangan pernah di-commit).
SECRET_KEY=

# === MOTION STUDIO (opsional untuk TTS) ===
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
MOTION_AUTO_PUBLISH_ENABLED=false
META_GRAPH_API_VERSION=v21.0

# === TELEGRAM NOTIFICATIONS (opsional) ===
# Kalau kosong, notifikasi dilewati tanpa error.
# Alternatif: isi telegram_bot_token & telegram_chat_id di data/config.json
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === CATATAN ===
# Gemini API key & token Facebook TIDAK dibaca dari sini.
# Keduanya disimpan di data/config.json dan diatur lewat dashboard.
